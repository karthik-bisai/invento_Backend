# Copy to backend/.env. `python run.py` reads it, and starts Postgres and Redis to match it if they aren't running.
APP_NAME=Invento
ENVIRONMENT=development
# The user, password, database name and port here are also what run.py gives the Postgres container it creates.
DATABASE_URL=postgresql+asyncpg://inventory:inventory_dev_password@localhost:5432/inventory
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=["http://localhost:5173"]

# ---- shared with the gateway (the gateway is the only caller of this API) ---------------------------------
# Must equal INTERNAL_API_KEY in gateway/.env. Lets only the gateway call /internal/*.
# INTERNAL_API_KEY=dev-internal-key
# Must equal MEDIA_PUBLIC_URL in gateway/.env. The API refuses avatar URLs that don't start with it.
# MEDIA_PUBLIC_URL=http://localhost:4000/media/
# The gateway forwards each user's real address in X-Forwarded-For so per-address limits stay accurate.
# TRUST_PROXY_HEADERS=true
